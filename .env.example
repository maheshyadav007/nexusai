# System settings for a company install. Copy this file to .env and fill it in, then restart.
# People using the app then only see their username, password and the model names.
# Leave out a section and that part works as before: the normal form, with Gmail and ChatGPT.
# The .env file is never committed, and it holds the API key in plain text.

# Model server. http:// and https:// both work.
NEXUSAI_MODEL_URL=http://10.0.0.1:8000/v1
NEXUSAI_MODEL_API_KEY=
# Optional. Comma-separated, and the first is the default. Empty asks the server for its list.
NEXUSAI_MODEL_NAMES=
# Set to true if the server supports tool calling. Off still works on any server, by having the
# model write its tool calls in its reply, which is less reliable.
NEXUSAI_MODEL_TOOLS=false

# Mail server. A Gmail login still goes to Gmail, over IMAP.
NEXUSAI_MAIL_PROTOCOL=pop3
NEXUSAI_MAIL_HOST=mail.example.com
NEXUSAI_MAIL_PORT=995
NEXUSAI_MAIL_SECURE=true
# Set to false if the server's certificate comes from the company's own authority.
NEXUSAI_MAIL_VERIFY_CERT=true
# Empty uses the mail host above.
NEXUSAI_SMTP_HOST=
NEXUSAI_SMTP_PORT=25
NEXUSAI_SMTP_SECURE=false
# Makes the sending address for a login with no @ in it: name becomes name@example.com.
NEXUSAI_MAIL_DOMAIN=example.com
