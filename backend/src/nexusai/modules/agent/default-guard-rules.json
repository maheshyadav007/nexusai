{
  "rules": [
    { "name": "Email addresses", "kind": "EMAIL", "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "action": "mask", "enabled": true },
    { "name": "Samsung links and hosts", "kind": "INT_URL", "pattern": "(?:https?://)?(?:[A-Za-z0-9-]+\\.)*[A-Za-z0-9-]*samsung[A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)+(?:[/?#][^\\s<>\"')]*)?", "action": "mask", "enabled": true },
    { "name": "Indian phone numbers", "kind": "PHONE", "pattern": "(?<![\\d+])(?:\\+?91[\\s-]?)?[6-9]\\d{4}[\\s-]?\\d{5}(?!\\d)", "action": "mask", "enabled": true },
    { "name": "International phone numbers", "kind": "PHONE", "pattern": "(?<![\\d+])\\+\\d{1,3}[\\s-]?\\(?\\d{1,4}\\)?(?:[\\s-]?\\d{2,4}){2,4}(?!\\d)", "action": "mask", "enabled": true }
  ]
}
