# Local deployment defaults. Copy/edit through desktop.sh profile-init.
NEXUSAI_MAIL_LABEL=Organization mail
NEXUSAI_MAIL_PROTOCOL=imap
NEXUSAI_MAIL_HOST=
NEXUSAI_MAIL_PORT=993
NEXUSAI_MAIL_SECURE=true
NEXUSAI_MAIL_VERIFY_CERT=true
NEXUSAI_SMTP_HOST=
NEXUSAI_SMTP_PORT=587
NEXUSAI_SMTP_SECURE=false
NEXUSAI_MAIL_DOMAIN=
NEXUSAI_MODEL_URL=
NEXUSAI_MODEL_NAMES=
NEXUSAI_MODEL_TOOLS=false
# Optional shared credential. Excluded from the installer unless embedCredentials is true.
NEXUSAI_MODEL_API_KEY=
