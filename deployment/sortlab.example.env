# Copy to sortlab.env and put it in the same folder as NexusAI-SortLab.exe.
# The same values as NEXUSAI_MAIL_* in company.env. Nothing else goes here: no passwords or keys.
NEXUSAI_MAIL_PROTOCOL=imap
NEXUSAI_MAIL_HOST=
NEXUSAI_MAIL_PORT=993
NEXUSAI_MAIL_SECURE=true
NEXUSAI_MAIL_VERIFY_CERT=true
# Added to a username that isn't a full address, like the app does.
NEXUSAI_MAIL_DOMAIN=
# How many of the newest emails to read.
NEXUSAI_SORTLAB_LIMIT=15000
